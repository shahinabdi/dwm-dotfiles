// fastfetch compact (no logo) — generated from config.jsonc by the fastfetch wrapper setup; edit config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "38;2;86;95;137",
      "output": "38;2;192;202;245"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#38;2;122;162;247}{user-name-colored}{#38;2;86;95;137}@{#38;2;122;162;247}{host-name-colored}",
      "color": {
        "user": "38;2;122;162;247",
        "at": "38;2;86;95;137",
        "host": "38;2;122;162;247"
      }
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}┌──────────────────── {#38;2;158;206;106}Hardware{#38;2;86;95;137} ────────────────────┐"
    },
    {
      "type": "host",
      "key": "   PC",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "cpu",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "display",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "disk",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "battery",
      "key": " │ ├",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "swap",
      "key": " └ └",
      "keyColor": "38;2;158;206;106"
    },
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}┌──────────────────── {#38;2;224;175;104}Software{#38;2;86;95;137} ────────────────────┐"
    },
    {
      "type": "os",
      "key": "   OS",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "kernel",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "packages",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "wm",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "shell",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "terminal",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "terminalfont",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "theme",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "icons",
      "key": " │ ├",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "cursor",
      "key": " └ └",
      "keyColor": "38;2;224;175;104"
    },
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}┌────────────────── {#38;2;187;154;247}Uptime / Age{#38;2;86;95;137} ──────────────────┐"
    },
    {
      "type": "command",
      "key": "   OS Age",
      "keyColor": "38;2;187;154;247",
      "text": "b=$(stat -c %W / 2>/dev/null); [ \"${b:-0}\" -gt 0 ] || b=$(stat -c %Y /lost+found 2>/dev/null || stat -c %Y /); d=$(( ($(date +%s) - b) / 86400 )); echo \"$d day$([ $d = 1 ] || echo s)\""
    },
    {
      "type": "uptime",
      "key": "   Uptime",
      "keyColor": "38;2;187;154;247"
    },
    {
      "type": "custom",
      "format": "{#38;2;86;95;137}└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
